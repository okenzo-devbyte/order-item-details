# Copy to .env, then uncomment and fill in SECRET_KEY and ADMIN_PASSWORD below.
# Those two are the only entries that ship commented out, so a file copied
# without editing them leaves the app on its built-in defaults: note that
# ADMIN_USERNAME is active while ADMIN_PASSWORD is not, which means an untouched
# copy runs as admin / change-me-now. Never commit .env.

# Supabase transaction pooler, port 6543. The direct connection is IPv6-only.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# JWT signing and cookie encryption. Generate a strong value; never ship the default.
# SECRET_KEY=

# First-run bootstrap of the admin account.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Set true once the service is behind HTTPS.
COOKIE_SECURE=true

# Hosts the API answers for. "*" is for local development only.
ALLOWED_HOSTS=*

# Session and idle lifetimes.
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
IDLE_TIMEOUT_MINUTES=30

RATE_LIMIT_PER_MINUTE=60

# Postgres schema names, interpolated into SQL identifiers, so they must be bare
# identifiers. Defaults: item, sales, app.
#
# The names here differ from the field names in api/config.py on purpose. The
# DB_SCHEMA_* spelling below is the contract. The bare SCHEMA_ITEM, SCHEMA_SALES
# and SCHEMA_APP spellings are still accepted for compatibility with an earlier
# deployment, and are left commented out on purpose. If one file sets both
# spellings of the same schema, DB_SCHEMA_* wins; across sources it does not,
# because a process environment variable beats a value in .env.
DB_SCHEMA_ITEM=item
DB_SCHEMA_SALES=sales
DB_SCHEMA_APP=app
# SCHEMA_ITEM=item
# SCHEMA_SALES=sales
# SCHEMA_APP=app

# The test suite connects to the same project under the t_ schemas. It falls
# back to DATABASE_URL, so this is only needed to point the tests at a different
# project than the one the app uses.
# TEST_DATABASE_URL=
